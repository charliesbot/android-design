  "functions": {
    "navigate": {
      "type": "object",
      "description": "Opens the screen with this id.",
      "returnType": "void",
      "properties": {
        "@call": {
          "const": "navigate"
        },
        "args": {
          "type": "object",
          "properties": {
            "screen": {
              "type": "string"
            }
          },
          "required": [
            "screen"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ]
    },
    "back": {
      "type": "object",
      "description": "Goes back one screen.",
      "returnType": "void",
      "properties": {
        "@call": {
          "const": "back"
        }
      },
      "required": [
        "@call"
      ]
    },
    "open": {
      "type": "object",
      "description": "Opens a BottomSheet, Dialog, Menu, SideSheet, SearchView, Snackbar or Tooltip of the same screen by id.",
      "returnType": "void",
      "properties": {
        "@call": {
          "const": "open"
        },
        "args": {
          "type": "object",
          "properties": {
            "overlay": {
              "type": "string"
            }
          },
          "required": [
            "overlay"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ]
    },
    "dismiss": {
      "type": "object",
      "description": "Closes the open overlay.",
      "returnType": "void",
      "properties": {
        "@call": {
          "const": "dismiss"
        }
      },
      "required": [
        "@call"
      ]
    }
  },
