      "description": "A renderer-side function call. Event actions are not supported.",
      "type": "object",
      "properties": {
        "functionCall": {
          "$ref": "#/$defs/anyFunction"
        }
      },
      "required": [
        "functionCall"
      ],
      "additionalProperties": false
    },
    "ComponentCommon": {
      "type": "object",
      "description": "Props every component accepts.",
      "properties": {
        "id": {
          "$ref": "a2ui-v1_0/common_types.json#/$defs/ComponentId"
        },
        "sizeClass": {
          "type": "object",
          "description": "Prop overrides per size class (large 225 dp and up).",
          "properties": {
            "large": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "style": {
          "type": "string",
          "description": "A style name from material.styles."
        },
        "weight": {
          "$ref": "a2ui-v1_0/common_types.json#/$defs/DynamicNumber",
          "description": "Relative weight inside a Row or Column. Must be a number from 0.01 to 100."
        },
        "padding": {
          "type": "string",
          "x-token": "spacing",
          "description": "Padding around the component. A name from the design system's spacing scale (default: none, xxs, xs, sm, md, lg, xl, xxl, xxxl)."
        }
      },
      "required": [
        "id"
      ]
    },
    "ColorRole": {
      "type": "string",
      "description": "A ColorScheme role.",
      "enum": [
        "primary",
        "primaryDim",
        "primaryContainer",
        "onPrimary",
        "onPrimaryContainer",
        "secondary",
        "secondaryDim",
        "secondaryContainer",
        "onSecondary",
        "onSecondaryContainer",
        "tertiary",
        "tertiaryDim",
        "tertiaryContainer",
        "onTertiary",
        "onTertiaryContainer",
        "surfaceContainerLow",
        "surfaceContainer",
        "surfaceContainerHigh",
        "onSurface",
        "onSurfaceVariant",
        "outline",
        "outlineVariant",
        "background",
        "onBackground",
        "error",
        "errorDim",
        "errorContainer",
        "onError",
        "onErrorContainer"
      ]
    },
    "TypeRole": {
      "type": "string",
      "description": "A Typography role.",
      "enum": [
        "displayLarge",
        "displayMedium",
        "displaySmall",
        "titleLarge",
        "titleMedium",
        "titleSmall",
        "labelLarge",
        "labelMedium",
        "labelSmall",
        "bodyLarge",
        "bodyMedium",
        "bodySmall",
        "bodyExtraSmall",
        "numeralExtraLarge",
        "numeralLarge",
        "numeralMedium",
        "numeralSmall",
        "numeralExtraSmall"
      ]
    }
