{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/charliesbot/android-design/main/app/schemas/wear.catalog.json",
  "protocolVersion": "1.0",
  "title": "Material 3 Expressive for Wear OS",
  "description": "Material 3 Expressive for Wear OS components that map one to one onto Wear Compose material3.",
  "catalogId": "https://github.com/charliesbot/android-design/catalogs/wear-m3-expressive/v1",
  "instructions": "Design guidelines for the wear catalog.\n\n1. A proposal draws from one catalog: every screen names the wear catalog id, and a watch proposal has no `navigation.panes`.\n2. Every prop that names a color or type takes a Wear role name, never a hex value. Wear's colors are its own ColorScheme (it has `primaryDim` and `surfaceContainerHigh`, but no `surface`), and its type roles include `numeral*` for glanceable numbers and `display*`. Use a `style` from the design system's `material.styles` to bundle tokens.\n3. Components reference children by id. A screen's root is usually a `Screen`: its `children` are the rows of a scrolling list (or a fixed stack with `scroll: false`), and its `edgeButton` is the one EdgeButton at the bottom edge. Overlays (`AlertDialog`, `ConfirmationDialog`) stay closed until an `open` action names them.\n4. Interaction is renderer-only: `navigate`, `back`, `open` and `dismiss`. Event actions do not exist.\n5. The display is round and always dark. Keep content inside the circle: a full-width `Button` in a `Screen` list scales and fades toward the edge, but a fixed `Column` that reaches the corners is clipped.\n6. Every tappable control needs a 48 dp touch target. Give every icon-only control a `contentDescription`.\n7. Use `sizeClass` with the `large` key to adapt a component on displays 225 dp and wider.",
  "components": {
    "Column": {
      "type": "object",
      "description": "Arranges children vertically.",
      "x-compose": "Column",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        }
      ],
      "properties": {
        "component": {
          "const": "Column"
        },
        "children": {
          "$ref": "a2ui-v1_0/common_types.json#/$defs/ChildList"
        },
        "spacing": {
          "type": "string",
          "x-token": "spacing",
          "description": "Gap between children (Arrangement.spacedBy). A name from the design system's spacing scale (default: none, xxs, xs, sm, md, lg, xl, xxl, xxxl)."
        },
        "horizontalAlignment": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end"
          ],
          "default": "start"
        },
        "arrangement": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly"
          ],
          "default": "start"
        },
        "scroll": {
          "$ref": "a2ui-v1_0/common_types.json#/$defs/DynamicBoolean",
          "description": "Makes the column vertically scrollable.",
          "default": false
        }
      },
      "required": [
        "component",
        "children"
      ],
      "unevaluatedProperties": false
    },
    "Row": {
      "type": "object",
