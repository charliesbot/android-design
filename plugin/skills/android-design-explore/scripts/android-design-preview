#!/bin/sh
set -eu

VERSION="0.7.0"
DEFAULT_GIT_URL="https://github.com/charliesbot/android-design.git"
CACHE_ROOT="${ANDROID_DESIGN_CACHE_DIR:-${ANDROID_DESIGN_PREVIEW_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/android-design-preview}}"

resolve_script_path() {
  _path="$1"
  while [ -L "$_path" ]; do
    _dir="$(CDPATH= cd -- "$(dirname -- "$_path")" && pwd -P)"
    _target="$(readlink "$_path")"
    case "$_target" in
      /*) _path="$_target" ;;
      *) _path="$_dir/$_target" ;;
    esac
  done
  _dir="$(CDPATH= cd -- "$(dirname -- "$_path")" && pwd -P)"
  printf '%s/%s\n' "$_dir" "$(basename -- "$_path")"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\r\t' '   '
}

fail_json() {
  _code="$1"
  _msg="$2"
  _esc_msg="$(json_escape "$_msg")"
  printf '{"ok":false,"errors":[{"code":"%s","message":"%s"}]}\n' "$_code" "$_esc_msg"
  exit 3
}

java_major() {
  _ver="$("$1" -version 2>&1 | sed -n 's/.*version "\([^"]*\)".*/\1/p' | head -n 1)"
  case "$_ver" in
    1.*)
      _rest="${_ver#1.}"
      printf '%s\n' "${_rest%%.*}"
      ;;
    "")
      printf '0\n'
      ;;
    *)
      printf '%s\n' "${_ver%%.*}"
      ;;
  esac
}

is_java_21_plus() {
  [ -x "$1" ] || return 1
  _maj="$(java_major "$1")"
  case "$_maj" in
    ""|*[!0-9]*) return 1 ;;
  esac
  [ "$_maj" -ge 21 ]
}

is_macos_java_stub() {
  [ "$1" = "/usr/bin/java" ] && [ ! -L "$1" ] && [ -x /usr/libexec/java_home ]
}

find_java() {
  if [ -n "${ANDROID_DESIGN_PREVIEW_JAVA:-}" ]; then
    is_java_21_plus "$ANDROID_DESIGN_PREVIEW_JAVA" || return 1
    printf '%s\n' "$ANDROID_DESIGN_PREVIEW_JAVA"
    return 0
  fi

  _java_cache="$CACHE_ROOT/java-bin-21"
  if [ -f "$_java_cache" ]; then
    IFS= read -r _cached_java < "$_java_cache" || _cached_java=""
    if [ -n "$_cached_java" ] && [ -x "$_cached_java" ] && ! is_macos_java_stub "$_cached_java"; then
      printf '%s\n' "$_cached_java"
      return 0
    fi
  fi

  _picked=""
  if [ -n "${JAVA_HOME:-}" ] && is_java_21_plus "${JAVA_HOME%/}/bin/java"; then
    _picked="${JAVA_HOME%/}/bin/java"
  fi

  if [ -z "$_picked" ] && [ -x /usr/libexec/java_home ]; then
    _mac_home="$(/usr/libexec/java_home -v 21+ 2>/dev/null || true)"
    if [ -n "$_mac_home" ] && is_java_21_plus "$_mac_home/bin/java"; then
      _picked="$_mac_home/bin/java"
    fi
  fi

  if [ -z "$_picked" ] && command -v java >/dev/null 2>&1; then
    _cmd_java="$(command -v java)"
    if ! is_macos_java_stub "$_cmd_java" && is_java_21_plus "$_cmd_java"; then
      _picked="$_cmd_java"
    fi
  fi

  if [ -z "$_picked" ]; then
    for _cand in \
      "/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin/java" \
      /opt/homebrew/opt/openjdk*/libexec/openjdk.jdk/Contents/Home/bin/java \
      /Library/Java/JavaVirtualMachines/*.jdk/Contents/Home/bin/java \
      "$HOME"/.gradle/jdks/*/*/Contents/Home/bin/java \
      "$HOME"/.gradle/jdks/*/bin/java \
      /usr/lib/jvm/java-*-openjdk*/bin/java \
      /usr/lib/jvm/jdk-*/bin/java; do
      if is_java_21_plus "$_cand"; then
        _picked="$_cand"
        break
      fi
    done
  fi

  [ -n "$_picked" ] || return 1
  mkdir -p "$CACHE_ROOT"
  printf '%s\n' "$_picked" > "$_java_cache"
  printf '%s\n' "$_picked"
}

java_home_matches_cache() {
  [ -n "${JAVA_HOME:-}" ] || return 1
  _jh_java="${JAVA_HOME%/}/bin/java"
  [ -x "$_jh_java" ] || return 1
  _java_cache="$CACHE_ROOT/java-bin-21"
  [ -f "$_java_cache" ] || return 1
  IFS= read -r _cached_java < "$_java_cache" || _cached_java=""
  [ -n "$_cached_java" ] && [ "$_jh_java" = "$_cached_java" ] && ! is_macos_java_stub "$_cached_java"
}

is_sdk_dir() {
  [ -n "$1" ] && [ -d "$1" ] && {
    [ -d "$1/platforms" ] || [ -d "$1/platform-tools" ] || [ -x "$1/platform-tools/adb" ]
  }
}

find_android_sdk() {
  if [ -n "${ANDROID_HOME:-}" ]; then
    if is_sdk_dir "$ANDROID_HOME"; then
      printf '%s\n' "$ANDROID_HOME"
      return 0
    fi
  fi
  if [ -n "${ANDROID_SDK_ROOT:-}" ]; then
    if is_sdk_dir "$ANDROID_SDK_ROOT"; then
      printf '%s\n' "$ANDROID_SDK_ROOT"
      return 0
    fi
  fi
  for _cand in \
    "$HOME/Library/Android/sdk" \
    "$HOME/Android/Sdk" \
    "/opt/android-sdk"; do
    if is_sdk_dir "$_cand"; then
      printf '%s\n' "$_cand"
      return 0
    fi
  done
  return 1
}

LOCK_PATH=""
LOCK_HELD=0

release_lock() {
  if [ "$LOCK_HELD" -eq 1 ]; then
    LOCK_HELD=0
    rm -f "$LOCK_PATH"
  fi
}

# Cross-process lock for the clone and Gradle export steps. A symlink whose target
# is the holder's pid is created atomically by ln -s, so the owner is never unknown.
acquire_lock() {
  mkdir -p "$CACHE_ROOT/$VERSION" || fail_json "cache_unwritable" "Cannot create $CACHE_ROOT/$VERSION"
  LOCK_PATH="$CACHE_ROOT/$VERSION/.lock"
  _lock_timeout="${ANDROID_DESIGN_PREVIEW_LOCK_TIMEOUT:-900}"
  _waited=0
  while ! ln -s "$$" "$LOCK_PATH" 2>/dev/null; do
    _holder="$(readlink "$LOCK_PATH" 2>/dev/null || true)"
    if [ -z "$_holder" ]; then
      continue
    fi
    _stale=0
    case "$_holder" in
      *[!0-9]*) _stale=1 ;;
      *) kill -0 "$_holder" 2>/dev/null || _stale=1 ;;
    esac
    if [ "$_stale" -eq 1 ]; then
      # Re-read before removing so a freshly taken lock is not discarded.
      if [ "$(readlink "$LOCK_PATH" 2>/dev/null || true)" = "$_holder" ] &&
        mv "$LOCK_PATH" "$LOCK_PATH.stale.$$" 2>/dev/null; then
        rm -f "$LOCK_PATH.stale.$$"
      fi
      continue
    fi
    if [ "$_waited" -ge "$_lock_timeout" ]; then
      fail_json "bootstrap_lock_timeout" "Another android-design-preview bootstrap (pid $_holder) held $LOCK_PATH for ${_lock_timeout}s. Wait for it, or remove the lock if that process is gone."
    fi
    sleep 1
    _waited=$((_waited + 1))
  done
  LOCK_HELD=1
}

resolve_existing_app_dir() {
  _script_dir="$1"

  if [ -n "${ANDROID_DESIGN_PREVIEW_SRC:-}" ]; then
    if [ -f "$ANDROID_DESIGN_PREVIEW_SRC/settings.gradle.kts" ]; then
      APP_DIR="$(CDPATH= cd -- "$ANDROID_DESIGN_PREVIEW_SRC" && pwd -P)"
      return 0
    elif [ -f "$ANDROID_DESIGN_PREVIEW_SRC/app/settings.gradle.kts" ]; then
      APP_DIR="$(CDPATH= cd -- "$ANDROID_DESIGN_PREVIEW_SRC/app" && pwd -P)"
      return 0
    fi
    fail_json "invalid_source_dir" "ANDROID_DESIGN_PREVIEW_SRC ($ANDROID_DESIGN_PREVIEW_SRC) does not contain settings.gradle.kts or app/settings.gradle.kts"
  fi

  if [ "${ANDROID_DESIGN_PREVIEW_FORCE_SPARSE:-0}" != "1" ]; then
    _repo_cand="$(CDPATH= cd -- "$_script_dir/../../../.." 2>/dev/null && pwd -P || true)"
    if [ -n "$_repo_cand" ] && [ -f "$_repo_cand/app/settings.gradle.kts" ]; then
      APP_DIR="$_repo_cand/app"
      return 0
    fi
  fi

  _src_app="$CACHE_ROOT/$VERSION/src/app"
  if [ -f "$_src_app/settings.gradle.kts" ] && [ -f "$_src_app/gradlew" ]; then
    APP_DIR="$_src_app"
    return 0
  fi

  return 1
}

resolve_app_dir() {
  _script_dir="$1"
  if resolve_existing_app_dir "$_script_dir"; then
    return 0
  fi

  _src_root="$CACHE_ROOT/$VERSION/src"
  _src_app="$_src_root/app"

  command -v git >/dev/null 2>&1 || fail_json "missing_git" "git is required to sparse-checkout android-design app sources"
  _git_url="${ANDROID_DESIGN_PREVIEW_GIT_URL:-$DEFAULT_GIT_URL}"
  _git_ref="${ANDROID_DESIGN_PREVIEW_GIT_REF:-v$VERSION}"
  _tmp_src="$CACHE_ROOT/$VERSION/src.tmp.$$"
  rm -rf "$_tmp_src"
  mkdir -p "$CACHE_ROOT/$VERSION"

  _cloned=0
  if git clone --depth 1 --filter=blob:none --no-checkout --branch "$_git_ref" "$_git_url" "$_tmp_src" 1>&2; then
    _cloned=1
  elif git clone --depth 1 --no-checkout --branch "$_git_ref" "$_git_url" "$_tmp_src" 1>&2; then
    _cloned=1
  fi
  if [ "$_cloned" -ne 1 ]; then
    rm -rf "$_tmp_src"
    fail_json "git_checkout_failed" "Failed to clone $_git_url at $_git_ref"
  fi

  if ! (
    git -C "$_tmp_src" sparse-checkout init --no-cone &&
    git -C "$_tmp_src" sparse-checkout set '/app/' &&
    git -C "$_tmp_src" checkout
  ) 1>&2; then
    rm -rf "$_tmp_src"
    fail_json "sparse_checkout_failed" "Failed to sparse-checkout app/ from $_git_url at $_git_ref"
  fi

  if [ ! -f "$_tmp_src/app/settings.gradle.kts" ]; then
    rm -rf "$_tmp_src"
    fail_json "sparse_checkout_incomplete" "Sparse checkout succeeded but app/settings.gradle.kts is missing"
  fi

  if [ -f "$_src_app/settings.gradle.kts" ] && [ -f "$_src_app/gradlew" ]; then
    rm -rf "$_tmp_src"
  else
    rm -rf "$_src_root"
    mv "$_tmp_src" "$_src_root"
  fi
  APP_DIR="$_src_app"
}

validate_paths_file() {
  _paths_file="$1"
  [ -s "$_paths_file" ] || return 1
  _saw_path=0
  while IFS= read -r _p || [ -n "$_p" ]; do
    case "$_p" in
      ""|\#*) continue ;;
    esac
    [ -e "$_p" ] || return 1
    _saw_path=1
  done < "$_paths_file"
  [ "$_saw_path" -eq 1 ]
}

validate_cp_file() {
  _cp_file="$1"
  [ -s "$_cp_file" ] || return 1
  _saw_cp=0
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      ""|-cp) continue ;;
    esac
    _old_ifs="$IFS"
    IFS=":"
    set -f
    for _entry in $_line; do
      [ -n "$_entry" ] || continue
      if [ ! -e "$_entry" ]; then
        set +f
        IFS="$_old_ifs"
        return 1
      fi
      _saw_cp=1
    done
    set +f
    IFS="$_old_ifs"
  done < "$_cp_file"
  [ "$_saw_cp" -eq 1 ]
}

bootstrap_valid() {
  _bdir="$1"
  _cmd="${2:-}"
  [ -s "$_bdir/bootstrap-meta.properties" ] || return 1
  [ -f "$_bdir/host-preview.apk" ] || return 1
  [ -f "$_bdir/androidx-compile-bundle.jar" ] || return 1
  [ -f "$_bdir/worker-r.jar" ] || return 1
  [ -f "$_bdir/worker-res-dirs.txt" ] || return 1
  [ -d "$_bdir/layoutlib/runtime/data" ] || return 1
  [ -d "$_bdir/layoutlib/resources/res" ] || return 1
  validate_paths_file "$_bdir/bootstrap-paths.txt" || return 1
  case "$_cmd" in
    server)
      validate_cp_file "$_bdir/server.cp" || return 1
      validate_cp_file "$_bdir/worker.cp" || return 1
      ;;
    check|tree|selection|open|status|stop|install|render)
      [ -s "$_bdir/server.cp" ] || return 1
      [ -s "$_bdir/worker.cp" ] || return 1
      validate_cp_file "$_bdir/client.cp" || return 1
      ;;
    *)
      validate_cp_file "$_bdir/client.cp" || return 1
      validate_cp_file "$_bdir/server.cp" || return 1
      validate_cp_file "$_bdir/worker.cp" || return 1
      ;;
  esac
  return 0
}

run_gradle_bootstrap() {
  _app_dir="$1"
  [ -x "$_app_dir/gradlew" ] || fail_json "missing_gradlew" "Expected executable gradlew in $_app_dir"
  if ! (cd "$_app_dir" && ./gradlew --no-daemon -Pkotlin.compiler.execution.strategy=in-process :host:exportBootstrap) 1>&2; then
    fail_json "gradle_bootstrap_failed" "Gradle :host:exportBootstrap failed in $_app_dir"
  fi
}

SCRIPT_PATH="$(resolve_script_path "$0")"
SCRIPT_DIR="$(dirname -- "$SCRIPT_PATH")"
export ANDROID_DESIGN_PREVIEW_SCRIPT="$SCRIPT_PATH"

JAVA_BIN="$(find_java)" || fail_json "missing_java" "Java 21 or newer not found. Install JDK 21+ or set JAVA_HOME."

SDK_DIR="$(find_android_sdk)" || fail_json "missing_android_sdk" "Android SDK not found. Set ANDROID_HOME or ANDROID_SDK_ROOT or install it under ~/Library/Android/sdk."
export ANDROID_HOME="$SDK_DIR"
export ANDROID_SDK_ROOT="$SDK_DIR"

# Gradle's ./gradlew reads JAVA_HOME, not JAVA_BIN. Keep an existing JAVA_HOME only
# when it points at a working Java 21+; otherwise derive it from the resolved JAVA_BIN.
_need_java_home=0
if [ -z "${JAVA_HOME:-}" ]; then
  _need_java_home=1
elif ! java_home_matches_cache; then
  _jh_java="${JAVA_HOME%/}/bin/java"
  if is_java_21_plus "$_jh_java"; then
    if [ -z "${ANDROID_DESIGN_PREVIEW_JAVA:-}" ] && ! is_macos_java_stub "$_jh_java"; then
      mkdir -p "$CACHE_ROOT"
      printf '%s\n' "$_jh_java" > "$CACHE_ROOT/java-bin-21"
    fi
  else
    _need_java_home=1
  fi
fi

if [ "$_need_java_home" -eq 1 ]; then
  _resolved_java="$(resolve_script_path "$JAVA_BIN")"
  _java_home_cand="$(CDPATH= cd -- "$(dirname -- "$_resolved_java")/.." && pwd -P)"
  _java_home_new=""
  if [ -f "$_java_home_cand/release" ] || { [ "$_java_home_cand" != "/usr" ] && [ "$_java_home_cand" != "/" ] && [ -x "$_java_home_cand/bin/javac" ]; }; then
    _java_home_new="$_java_home_cand"
  elif [ -x /usr/libexec/java_home ]; then
    _java_home_new="$(/usr/libexec/java_home -v 21+ 2>/dev/null || true)"
  fi
  if [ -n "$_java_home_new" ]; then
    JAVA_HOME="$_java_home_new"
    export JAVA_HOME
  elif [ -n "${JAVA_HOME:-}" ]; then
    # A stale JAVA_HOME must not reach Gradle; let it fall back to java on PATH.
    unset JAVA_HOME
  fi
fi

cmd="${1:-}"
APP_DIR=""
BOOTSTRAP_DIR=""
_warm_ready=0
if resolve_existing_app_dir "$SCRIPT_DIR"; then
  BOOTSTRAP_DIR="${ANDROID_DESIGN_PREVIEW_BOOTSTRAP_DIR:-$APP_DIR/host/build/bootstrap}"
  if bootstrap_valid "$BOOTSTRAP_DIR" "$cmd"; then
    _warm_ready=1
  fi
fi

if [ "$_warm_ready" -ne 1 ]; then
  trap release_lock EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  acquire_lock

  if [ -z "$APP_DIR" ]; then
    resolve_app_dir "$SCRIPT_DIR"
    BOOTSTRAP_DIR="${ANDROID_DESIGN_PREVIEW_BOOTSTRAP_DIR:-$APP_DIR/host/build/bootstrap}"
  fi

  if ! bootstrap_valid "$BOOTSTRAP_DIR" "$cmd"; then
    run_gradle_bootstrap "$APP_DIR"
    bootstrap_valid "$BOOTSTRAP_DIR" || fail_json "bootstrap_invalid" "Gradle bootstrap completed but outputs in $BOOTSTRAP_DIR are incomplete"
  fi

  release_lock
fi

export ANDROID_DESIGN_CACHE_DIR="$CACHE_ROOT"
export ANDROID_DESIGN_PREVIEW_SRC="$APP_DIR"
export ANDROID_DESIGN_PREVIEW_BOOTSTRAP_DIR="$BOOTSTRAP_DIR"
export ANDROID_DESIGN_PREVIEW_SERVER_CP="$BOOTSTRAP_DIR/server.cp"
export ANDROID_DESIGN_PREVIEW_CLIENT_CP="$BOOTSTRAP_DIR/client.cp"
export ANDROID_DESIGN_PREVIEW_WORKER_CP="$BOOTSTRAP_DIR/worker.cp"

case "$cmd" in
  server)
    exec "$JAVA_BIN" -Djava.awt.headless=true "@$BOOTSTRAP_DIR/server.cp" bot.charlies.androiddesign.preview.app.MainKt "$@"
    ;;
  *)
    exec "$JAVA_BIN" -Djava.awt.headless=true -XX:+TieredCompilation -XX:TieredStopAtLevel=1 "@$BOOTSTRAP_DIR/client.cp" bot.charlies.androiddesign.preview.app.MainKt "$@"
    ;;
esac
